# BENCH ONLY (docs/ota/before-production.md item 13): a node whose temperature and humidity are
# scripted — slow heat to 60 C: the fixed alarm, 180 s after every boot.
# firmware/build.sh node --mock 1  ->  apps/node/build-mock1
CONFIG_SIOT_FEATURE_SENSING=y
CONFIG_SIOT_SENSOR_MOCK=y
CONFIG_SIOT_SENSOR_MOCK_SCENARIO=1
