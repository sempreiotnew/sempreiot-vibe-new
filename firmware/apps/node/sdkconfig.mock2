# BENCH ONLY (docs/ota/before-production.md item 13): a node whose temperature and humidity are
# scripted — +10 C in 40 s: the rate-of-rise alarm, 180 s after every boot.
# firmware/build.sh node --mock 2  ->  apps/node/build-mock2
CONFIG_SIOT_FEATURE_SENSING=y
CONFIG_SIOT_SENSOR_MOCK=y
CONFIG_SIOT_SENSOR_MOCK_SCENARIO=2
