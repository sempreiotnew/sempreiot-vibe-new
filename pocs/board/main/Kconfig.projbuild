menu "SIOT Board (tablet serial link)"

    choice SIOT_SERIAL_LINK
        prompt "Peripheral carrying the SAFR byte stream to the tablet"
        default SIOT_SERIAL_LINK_USB_SERIAL_JTAG
        help
            docs/definition-central.md: the product board's tablet link is
            the S3's native USB on GPIO19/20 (USB-Serial-JTAG); UART0 on
            GPIO43/44 is the flash/debug port. Default = native USB. Pick
            UART0 for a bench where the USB connector is not populated and
            the tablet hangs off the USB-TTL adapter on 43/44 (that is what
            pocs/board/sdkconfig.defaults selects for POC round 1).

        config SIOT_SERIAL_LINK_UART0
            bool "UART0 via the devkit's USB-UART bridge chip (GPIO43/44)"
        config SIOT_SERIAL_LINK_USB_SERIAL_JTAG
            bool "Native USB-Serial-JTAG (the connector seen as /dev/cu.usbmodem*)"
    endchoice

endmenu
